# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# LLM router — primary + fallback (no model IDs hardcoded anywhere else)
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-2.0-flash
LLM_PRIMARY_API_KEY=

LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_API_KEY=

LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Planner bounds (§5, A8)
MAX_CANDIDATES=4
MAX_REVISIONS=2

# Confidence gate (§16, CF4)
CONFIDENCE_THRESHOLD=0.65

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# App
APP_ENV=dev
LOG_LEVEL=INFO
